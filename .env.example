# Copy this file to .env.local and change every example value before use.
POSTGRES_USER=rinde_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=rinde_plus
DATABASE_URL=postgresql://rinde_app:replace-with-a-long-random-password@localhost:5432/rinde_plus

# Initial administrator created by `npm run db:seed`.
ADMIN_NAME=Administración
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-bytes
BUSINESS_TIME_ZONE=America/Lima

# Optional Gmail SMTP delivery for support tickets. Use a Gmail App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL=
